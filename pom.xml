<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecs</groupId>
    <artifactId>enterprise-commerce-suite</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Enterprise Commerce Suite</name>
    <description>Open-source enterprise e-commerce platform for the Indian commerce ecosystem. Owner: Pawan Gunjkar (pawangunjkar@gmail.com).</description>
    <url>https://github.com/Pawangunjkar/enterprise-commerce-suite</url>
    <inceptionYear>2026</inceptionYear>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>Pawangunjkar</id>
            <name>Pawan Gunjkar</name>
            <email>pawangunjkar@gmail.com</email>
            <url>https://github.com/Pawangunjkar</url>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/Pawangunjkar/enterprise-commerce-suite.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Pawangunjkar/enterprise-commerce-suite.git</developerConnection>
        <url>https://github.com/Pawangunjkar/enterprise-commerce-suite</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>platform-infrastructure</module>
        <module>master-enterprise-catalog</module>
        <module>order-management-system</module>
        <module>billing-system</module>
        <module>customer-relationship-management</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.5</spring-boot.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <mapstruct.version>1.6.2</mapstruct.version>
        <lombok.version>1.18.34</lombok.version>
        <testcontainers.version>1.20.3</testcontainers.version>
        <jjwt.version>0.12.6</jjwt.version>
        <hypersistence.version>3.8.3</hypersistence.version>
        <zxing.version>3.5.3</zxing.version>
        <json-schema.version>1.5.2</json-schema.version>
        <opencsv.version>5.9</opencsv.version>
        <poi.version>5.3.0</poi.version>
        <pdfbox.version>3.0.3</pdfbox.version>
        <caffeine.version>3.1.8</caffeine.version>
        <redisson.version>3.37.0</redisson.version>
        <quartz.version>2.3.2</quartz.version>
        <solr.version>9.7.0</solr.version>
        <springdoc.version>2.6.0</springdoc.version>
        <flyway.version>10.20.1</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.ecs</groupId>
                <artifactId>common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ecs</groupId>
                <artifactId>common-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ecs</groupId>
                <artifactId>common-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ecs</groupId>
                <artifactId>payment-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ecs</groupId>
                <artifactId>logistics-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ecs</groupId>
                <artifactId>ondc-beckn-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ecs</groupId>
                <artifactId>saga-orchestration</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>build-all</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <id>build-mec</id>
            <modules>
                <module>platform-infrastructure</module>
                <module>master-enterprise-catalog</module>
            </modules>
        </profile>
        <profile>
            <id>build-oms</id>
            <modules>
                <module>platform-infrastructure</module>
                <module>order-management-system</module>
            </modules>
        </profile>
        <profile>
            <id>build-billing</id>
            <modules>
                <module>platform-infrastructure</module>
                <module>billing-system</module>
            </modules>
        </profile>
        <profile>
            <id>build-crm</id>
            <modules>
                <module>platform-infrastructure</module>
                <module>customer-relationship-management</module>
            </modules>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
