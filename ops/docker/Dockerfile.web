FROM node:22-alpine AS build
WORKDIR /app
COPY platform-infrastructure/frontend-monorepo/ ./
RUN npm install
ARG APP_NAME
RUN npx turbo run build --filter=${APP_NAME}

FROM nginx:1.27-alpine
ARG APP_NAME
COPY --from=build /app/apps/${APP_NAME}/dist /usr/share/nginx/html
COPY ops/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
